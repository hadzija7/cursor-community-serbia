# Postgres (from Vercel Marketplace integration, e.g. Neon)
# Automatically set when you add a Postgres database in Vercel.
# POSTGRES_URL=
# DATABASE_URL=

# Optional: webhook to notify on new subscriptions (e.g. Zapier, Make)
# MAILING_LIST_WEBHOOK_URL=
# MAILING_LIST_API_KEY=

# Optional: Luma API key for fetching managed calendar events (requires Luma Plus).
# Without this, only listed events from the public calendar page are fetched.
# Same key is used to add new website subscribers to your calendar (POST /v1/calendar/import-people).
# LUMA_API_KEY=
# LUMA_API_BASE_URL=https://public-api.luma.com
# Optional: comma-separated tag names (must already exist in Luma) applied on import from /api/subscribe.
# LUMA_IMPORT_TAG_NAMES=
# Optional: calendar slug for listed events. Inferred from site.config.ts lumaUrl if omitted.
# LUMA_CALENDAR_SLUG=cursor-serbia
