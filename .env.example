# Canonical site URL (Open Graph, sitemap, robots). Defaults to https://cursorserbia.com.
# NEXT_PUBLIC_SITE_URL=https://cursorserbia.com

# Optional: public hackathon subdomain. When set, community links and /hackathon
# redirect to this host. Add the domain in Vercel first (see specs/hackathon.md).
# NEXT_PUBLIC_HACKATHON_SITE_URL=https://hackathon.cursorserbia.com

# Postgres (from Vercel Marketplace integration, e.g. Neon)
# Automatically set when you add a Postgres database in Vercel.
# POSTGRES_URL=
# DATABASE_URL=

# Optional: webhook to notify on new subscriptions (e.g. Zapier, Make)
# MAILING_LIST_WEBHOOK_URL=
# MAILING_LIST_API_KEY=

# Optional: dedicated webhook for hackathon sponsorship applications (falls back to MAILING_LIST_WEBHOOK_URL)
# For Google Sheets: deploy scripts/hackathon-sponsor-google-sheet.gs as an Apps Script web app, then set:
# HACKATHON_SPONSOR_WEBHOOK_URL=https://script.google.com/macros/s/.../exec?key=YOUR_SECRET
# (Omit HACKATHON_SPONSOR_API_KEY for Apps Script — auth uses ?key= on the URL.)
# HACKATHON_SPONSOR_WEBHOOK_URL=
# HACKATHON_SPONSOR_API_KEY=

# Optional: Luma API keys for city calendars (requires Luma Plus).
# Upcoming events are fetched from both calendars when configured.
# New website subscribers are imported into each configured calendar.
# LUMA_BELGRADE_API_KEY=
# LUMA_NOVI_SAD_API_KEY=
# LUMA_API_BASE_URL=https://public-api.luma.com
# Optional: comma-separated tag names (must already exist in Luma) applied on import from /api/subscribe.
# LUMA_IMPORT_TAG_NAMES=

# Google OAuth for hacker login (hackathon attendee auth)
# Create credentials at https://console.cloud.google.com/apis/credentials
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_SECRET= # openssl rand -base64 32

# Hackathon credit codes — shared promo codes (same for every checked-in claimant)
# CREDIT_CODE_DAYTONA=
# CREDIT_CODE_EXA=
# CREDIT_CODE_FAL=
# CREDIT_CODE_WISPR=
# CREDIT_CODE_WONDER=
# CREDIT_CODE_NETLIFY=
# CREDIT_CODE_FIRECRAWL=
# CREDIT_CODE_CONVEX=
# CREDIT_CODE_ELEVENLABS=
# CREDIT_CODE_RENDER=
# Cursor Pro referral links are unique and live in Postgres.
# Put them in the gitignored db/data/cursor-referrals.txt (see .example), then:
#   pnpm db:seed:cursor-referrals
